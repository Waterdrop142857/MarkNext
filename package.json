  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "pnpm test:unit && pnpm test:document-actions",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "node scripts/check.mjs",
    "check:frontend": "node scripts/check.mjs --frontend",
    "check:native": "node scripts/check.mjs --native",
    "test:document-actions": "node --test tests/document-actions.test.cjs",
    "test:shortcuts": "vitest run src/composables/__tests__/shortcuts.spec.ts",
    "test:selection": "vitest run src/components/editor/__tests__/webkitSelectionPainter.spec.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
