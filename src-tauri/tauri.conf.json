{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkNext",
  "version": "0.1.0",
  "identifier": "com.marknext.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkNext",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "label": "main",
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate",
        "description": "Markdown document"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate",
        "description": "Text document"
      }
    ],
    "macOS": {
      "infoPlist": "macos/Info.plist",
      "files": {
        "Resources/markdown.icns": "icons/markdown.icns"
      }
    },
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/open-with.nsh",
        "languages": ["English", "SimpChinese"]
      }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/mimetypes/text-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/text-x-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-markdown.png": "icons/markdown.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-x-markdown.png": "icons/markdown.png"
        }
      },
      "deb": {
        "desktopTemplate": "templates/marknext.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/mimetypes/text-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/text-x-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-markdown.png": "icons/markdown.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-x-markdown.png": "icons/markdown.png"
        },
        "postInstallScript": "linux/update-icon-cache.sh",
        "postRemoveScript": "linux/update-icon-cache.sh"
      },
      "rpm": {
        "desktopTemplate": "templates/marknext.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/mimetypes/text-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/text-x-markdown.svg": "../public/icons/markdown.svg",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-markdown.png": "icons/markdown.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/text-x-markdown.png": "icons/markdown.png"
        },
        "postInstallScript": "linux/update-icon-cache.sh",
        "postRemoveScript": "linux/update-icon-cache.sh"
      }
    }
  }
}
