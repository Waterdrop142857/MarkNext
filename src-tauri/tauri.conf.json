{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkNext",
  "version": "0.1.0",
  "identifier": "com.marknext.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkNext",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate",
        "description": "Markdown document"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate",
        "description": "Text document"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "templates/marknext.desktop"
      },
      "rpm": {
        "desktopTemplate": "templates/marknext.desktop"
      }
    }
  }
}
